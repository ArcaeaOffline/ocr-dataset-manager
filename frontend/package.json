{
  "name": "odm-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "test": "vitest run",
    "generate:api": "node scripts/generate-api.mjs && oxfmt --write src/api-schema.d.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.46",
    "vue-router": "^5.5.1",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.157",
    "@types/node": "^26.6.6",
    "@unocss/reset": "^66.13.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/tsconfig": "^0.9.1",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "~5.9.0",
    "unocss": "^66.13.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  },
  "packageManager": "pnpm@12.6.0"
}
